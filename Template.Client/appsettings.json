{
  //#if (UseAzureAd)
  // Configure these identity settings (App registration in the Entra portal)
  // before the app can sign users in:
  // https://github.com/AzureAD/microsoft-identity-web/blob/master/tools/app-provisioning-tool/vs2019-16.9-how-to-use.md
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "Domain": "qualified.domain.name",
    "TenantId": "22222222-2222-2222-2222-222222222222",
    "ClientId": "11111111-1111-1111-11111111111111111",
    "CallbackPath": "/signin-oidc"
  },
  //#endif
  //#if (UseSentry)
  // Leave Dsn empty to disable Sentry locally. Set via env/user-secrets in deploy.
  "Sentry": {
    "Dsn": "",
    "TracesSampleRate": 0.1,
    "SendDefaultPii": false
  },
  //#endif
  //#if (!UseEfCore)
  "Storage": {
    "ContactSubmissionsTableName": "ContactSubmissions",
    "PrivateContainerName": "app-private",
    "JobsQueueName": "app-jobs"
  },
  //#endif
  "Seo": {
    "AllowIndexing": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
